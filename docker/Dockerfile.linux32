FROM i386/ubuntu:18.04
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip binutils build-essential \
        libxml2-dev libxslt1-dev zlib1g-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /venv && /venv/bin/pip install --upgrade "pip<22" setuptools wheel

WORKDIR /app
COPY requirements-linux32.txt .
RUN /venv/bin/pip install -r requirements-linux32.txt

COPY config.py database.py indexador_service.py buscador_service.py servidor.py ./

RUN /venv/bin/pyinstaller --onefile --name biblioteca \
        --collect-submodules sklearn --collect-submodules pypdf --hidden-import typing_extensions --collect-data docx \
        --exclude-module matplotlib --exclude-module tkinter \
        --collect-submodules segno \
        servidor.py

CMD cp /app/dist/biblioteca /out/biblioteca && chown $HOST_UID:$HOST_GID /out/biblioteca
